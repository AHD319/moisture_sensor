import RPi.GPIO as GPIO
import time

led_pin = 21 # pin number led is in
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM) 
GPIO.setup(led_pin, GPIO.OUT) # led is an output so in the setup its GPIO.OUT

while True: # forever loop for blinking led
    GPIO.output(led_pin, GPIO.HIGH) # when GPIO is high LED is on
    time.sleep(2)
    GPIO.output(led_pin, GPIO.LOW) # when GPIO is low LED is off
