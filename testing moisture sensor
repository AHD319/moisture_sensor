import RPi.GPIO as GPIO
import time

MOISTURE_PIN = 17  # setting moisture sensor as gpio pin 17
GPIO.setmode(GPIO.BCM)# using the broadcom chip pin
GPIO.setup(MOISTURE_PIN, GPIO.IN) #sensor itself reads high when its ry and low when its wet

while True:
    if GPIO.input(MOISTURE_PIN):
        print("Dry")
    else:
        print("Wet")
    time.sleep(1)
